{
  "name": "tpu-schedule-filter",
  "version": "0.1.0",
  "private": true,
  "description": "Local, precise lesson filtering for TPU timetables in Firefox and Zen",
  "scripts": {
    "test": "node --test --experimental-test-isolation=none tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
    "dev": "web-ext run --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --filename tpu-schedule-filter-{version}.zip --overwrite-dest"
  },
  "engines": { "node": ">=22.23.1" },
  "devDependencies": { "jsdom": "27.2.0", "web-ext": "10.8.0" }
}
