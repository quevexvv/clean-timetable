{
  "manifest_version": 3,
  "name": "Clean Timetable for TPU",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "ru",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "tpu-schedule-filter@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "background": { "scripts": ["core/site.js", "core/rules.js", "core/store.js", "background.js"] },
  "content_scripts": [{
    "matches": [
      "https://my-rasp.tpu.ru/gruppa_*/view.html", "https://my-rasp.tpu.ru/gruppa_*/*/view.html",
      "https://ro-rasp.tpu.ru/gruppa_*/view.html", "https://ro-rasp.tpu.ru/gruppa_*/*/view.html"
    ],
    "js": ["core/site.js", "core/rules.js", "content/parser.js", "content/ui.js", "content/app.js"],
    "css": ["content/styles.css"],
    "run_at": "document_idle"
  }]
}
